# 生产环境变量模板：复制为仓库根的 .env 后填写
#   cp deploy/env.prod.example .env
# ⚠ .env 已在 .gitignore 中，千万别提交到仓库。

# ---------------------------------------------------------------- 必填：至少一把文本模型 key
# 阿里云 ECS 出网提示：硅基流动 / 阿里百炼 / DeepSeek 国内直连正常；
# apihub.agnes-ai.com 在部分网络下 TLS 被拦（本机实测），若图像网关不通就换 DASHSCOPE。
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 文本模型（可用 /v1/models 查 id）
AGENT_MODEL=deepseek-ai/DeepSeek-V3.2
AGENT_SUB_MODEL=deepseek-ai/DeepSeek-V3.2

# ---------------------------------------------------------------- 图像生成（可选，不填则无渲染图）
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
# 阿里云百炼：国内 ECS 更稳的图床备选（前端「模型设置」也能临时切）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------------------------------------------------------------- CAD 运行时
# auto = 有 E2B_API_KEY 走云端沙箱，否则退回本地 build123d（需装 requirements-cad.txt）
# 2C4G / 4C8G 实例强烈建议配 E2B_API_KEY：本机跑 OCP 建模并发必崩
AGENT_CAD_RUNTIME=auto
E2B_API_KEY=

# ---------------------------------------------------------------- 服务监听
# 容器部署必须为 0.0.0.0（绑 127.0.0.1 时 nginx 与跨容器访问全连不上）
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
AGENT_MOCK=0

# ---------------------------------------------------------------- 超时与续跑
AGENT_MAX_SECONDS=900
AGENT_TIMEOUT_EXTEND=600
AGENT_AUTO_RESUME_MAX=2
