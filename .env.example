# 复制为 .env 后填写；不要提交真实密钥
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 智能体使用的模型（硅基流动上的 id，可用 /v1/models 查询）
AGENT_MODEL=deepseek-ai/DeepSeek-V3.2
AGENT_SUB_MODEL=deepseek-ai/DeepSeek-V3.2

# Agnes AI：产品渲染图 / 爆炸图（不填则图片生成不可用，其余流程不受影响）
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# worker 监听端口（与前端 AGENT_WORKER_URL 对应）
AGENT_PORT=8001

# 1 = 强制演示模式（不调用模型），0 = 真实智能体
AGENT_MOCK=0

# ---------------------------------------------------------------- 深度思考
# 1 = 请求模型输出思维链（前端「深度思考」区块会实时流式展示）
AGENT_THINKING=1
# 思考开关的具体请求体参数，因模型而异，JSON 格式：
#   deepseek-ai/DeepSeek-V3.2      -> {"thinking_budget": 2048}
#   Qwen/Qwen3-*                   -> {"enable_thinking": true}
#   留空则不附加任何参数（仅当模型默认就返回 reasoning_content 时才有思考流）
AGENT_THINKING_BODY=

# ---------------------------------------------------------------- 超时与续跑
# 档位时限到点后**不是立刻中止**：只要还在产出新内容就自动延长（时间到 ≠ 卡住）
AGENT_TIMEOUT_EXTEND=600          # 每次续期秒数
AGENT_RUN_HARD_SECONDS=0          # 单轮硬上限，0 = 按「档位时限 × 2」推导
AGENT_TIMEOUT_WARN_RATIO=0.8      # 用掉多少比例时限时预警
AGENT_AUTO_RESUME_MAX=2           # 超时且未完成时，自动续跑几轮（复用同一工作区）
